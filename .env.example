# Beaulix Backend — Environment Variables
# Copy this file to .env and fill in your values before deploying.
# Never commit .env to version control.

# ── Authentication ──────────────────────────────────────────────────────
# Required in production. All /predict and /predict-step2 endpoints are
# publicly accessible if this is not set. The server refuses to start in
# production mode (BEAULIX_ENV=production) without it.
BEAULIX_API_KEY=<secret-random-string>

# ── CORS / Frontend ─────────────────────────────────────────────────────
# Required in production. Must match your Firebase Hosting URL exactly.
# The server refuses to start in production mode without it.
# Example: https://your-project.web.app
BEAULIX_FRONTEND_URL=https://your-project.web.app

# ── Environment mode ────────────────────────────────────────────────────
# Set to "production" to enable startup-time enforcement of the two
# required variables above, and to disable dev-only CORS fallbacks.
# Leave unset (or set to anything else) for local development.
BEAULIX_ENV=production

# ── Cloudinary (avatar image uploads) ──────────────────────────────────
# Obtained from your Cloudinary dashboard or Firebase secrets.
# Required for avatar upload functionality in the frontend.
CLOUDINARY_CLOUD_NAME=<from-firebase-secrets>
CLOUDINARY_API_KEY=<from-firebase-secrets>
CLOUDINARY_API_SECRET=<from-firebase-secrets>

# ── Meta Ads integration (Phase 2A) ─────────────────────────────────────
# From your Meta Developer App Dashboard > App Settings > Basic.
# Never commit real values — see docs/meta-integration.md for setup.
META_APP_ID=<your-meta-app-id>
META_APP_SECRET=<your-meta-app-secret>
# Must exactly match a redirect URI registered under
# Facebook Login for Business > Settings in the Meta App Dashboard.
# Example: https://your-backend.onrender.com/integrations/meta/callback
META_REDIRECT_URI=https://your-backend-host/integrations/meta/callback
# Optional. Defaults to META_APP_SECRET if unset — set a dedicated value if
# you'd rather not reuse the Meta app secret to sign OAuth CSRF state.
META_OAUTH_STATE_SECRET=<secret-random-string>
# Optional. Graph API version to call. Defaults to v26.0.
META_GRAPH_API_VERSION=v26.0
# Optional. Path (relative to BEAULIX_FRONTEND_URL) the backend redirects to
# after a Meta connect attempt finishes. Defaults to /performance.html.
META_FRONTEND_RETURN_PATH=/performance.html

# ── Firestore Admin access (used by the Meta integration above) ────────
# Full JSON key for a Firebase service account with Firestore access.
# Same convention backend/download_data.py already uses for Google Drive.
# NEVER commit the key file itself — paste its JSON content here as one line,
# or set GOOGLE_APPLICATION_CREDENTIALS to a path instead if your host
# prefers a mounted file. Rotate immediately if either is ever exposed:
# https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=<paste-the-full-service-account-json-as-one-line>

# ── Colab / GPU (sdxl_model.py) ─────────────────────────────────────────
# Directory on the Colab runtime where Beaulix music/audio assets are stored.
# Defaults to "/content" if not set. Only required when running the Colab GPU
# component — not needed for the FastAPI backend.
BEAULIX_MUSIC_DIR=/content
